FLASK_APP=backend.wsgi:app
FLASK_ENV=development
SECRET_KEY=change-me-in-local-dev
DATABASE_URL=sqlite:///instance/flowtally_pilot.db
FLOWTALLY_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_NAME=flowtally_pilot_session
FLOWTALLY_RATE_LIMIT_STORAGE_URI=memory://
WTF_CSRF_TIME_LIMIT=3600

