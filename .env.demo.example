FLOWTALLY_ENV=staging
SECRET_KEY=<separate strong demo secret>
DATABASE_URL=<separate demo-only PostgreSQL URL>
FLOWTALLY_MIGRATION_DATABASE_URL=<separate demo migration/admin URL>
FLOWTALLY_ALLOWED_ORIGINS=https://demo.flowtally.ca
FLOWTALLY_FRONTEND_ORIGIN=https://demo.flowtally.ca
FLOWTALLY_ENFORCE_SPLIT_ORIGIN_CSRF=true
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_NAME=flowtally_demo_session
FLOWTALLY_RATE_LIMIT_STORAGE_URI=<demo Redis or managed rate-limit store URL>
FLOWTALLY_ALLOW_SQLITE_IN_NONLOCAL=false
GOOGLE_OIDC_ENABLED=false
SQUARE_ENABLED=false
FLOWTALLY_DEMO_READ_ONLY=true

# Frontend build variables
VITE_ENABLE_PILOT_APP=true
VITE_PILOT_API_BASE_URL=https://api-demo.flowtally.ca
VITE_FLOWTALLY_API_BASE_URL=https://api-demo.flowtally.ca
VITE_FLOWTALLY_DEMO_READ_ONLY=true

