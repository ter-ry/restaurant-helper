# Private writable showcase only. Never reuse production or customer credentials.
FLOWTALLY_ENV=staging
FLOWTALLY_SHOWCASE_ENABLED=true
FLOWTALLY_SHOWCASE_DATABASE_NAME=flowtally_showcase
FLOWTALLY_SHOWCASE_ORGANIZATION_NAME=Harbour Kitchen
DATABASE_URL=postgresql://showcase_runtime:replace-me@example.invalid/flowtally_showcase
FLOWTALLY_MIGRATION_DATABASE_URL=postgresql://showcase_migrator:replace-me@example.invalid/flowtally_showcase
FLOWTALLY_ALLOWED_ORIGINS=https://showcase.flowtally.example
FLOWTALLY_FRONTEND_ORIGIN=https://showcase.flowtally.example
FLOWTALLY_ENFORCE_SPLIT_ORIGIN_CSRF=true
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=None
SESSION_COOKIE_NAME=flowtally_showcase_session
FLOWTALLY_RATE_LIMIT_STORAGE_URI=redis://replace-me
FLOWTALLY_DEMO_READ_ONLY=false
GOOGLE_OIDC_ENABLED=true
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_REDIRECT_URI=https://api-showcase.flowtally.example/api/auth/google/callback
OCR_SPACE_API_KEY=replace-me
OCR_SPACE_ENDPOINT=https://api.ocr.space/parse/image
OCR_SPACE_LANGUAGE=eng
OCR_SPACE_ENGINE=2
OCR_SPACE_TIMEOUT=90
SQUARE_ENABLED=true
SQUARE_ENVIRONMENT=sandbox
SQUARE_APPLICATION_ID=replace-me
SQUARE_APPLICATION_SECRET=replace-me
SQUARE_REDIRECT_URI=https://api-showcase.flowtally.example/api/integrations/square/callback
SQUARE_WEBHOOK_SIGNATURE_KEY=replace-me
SQUARE_WEBHOOK_NOTIFICATION_URL=https://api-showcase.flowtally.example/api/integrations/square/webhooks
INTEGRATION_ENCRYPTION_KEY=replace-me-with-a-fernet-key
