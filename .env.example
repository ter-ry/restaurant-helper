FLOWTALLY_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///backend/instance/flowtally_pilot.db
FLOWTALLY_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SESSION_COOKIE_SECURE=false
FLOWTALLY_RATE_LIMIT_STORAGE_URI=memory://
SESSION_COOKIE_NAME=flowtally_pilot_session
SESSION_COOKIE_SAMESITE=Lax
MAX_CONTENT_LENGTH=15728640
