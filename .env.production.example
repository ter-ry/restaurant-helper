FLOWTALLY_ENV=production
SECRET_KEY=<new strong random production secret>
DATABASE_URL=<new empty production runtime PostgreSQL URL>
FLOWTALLY_MIGRATION_DATABASE_URL=<production migration/admin PostgreSQL URL>
FLOWTALLY_ALLOWED_ORIGINS=https://app.flowtally.ca
FLOWTALLY_FRONTEND_ORIGIN=https://app.flowtally.ca
FLOWTALLY_ENFORCE_SPLIT_ORIGIN_CSRF=true
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_NAME=flowtally_session
FLOWTALLY_RATE_LIMIT_STORAGE_URI=<production Redis or managed rate-limit store URL>
FLOWTALLY_ALLOW_SQLITE_IN_NONLOCAL=false
MAX_CONTENT_LENGTH=15728640
GOOGLE_OIDC_ENABLED=true
GOOGLE_CLIENT_ID=<production Google client ID>
GOOGLE_CLIENT_SECRET=<production Google client secret>
GOOGLE_REDIRECT_URI=https://api.flowtally.ca/api/auth/google/callback
SQUARE_ENABLED=true
SQUARE_ENVIRONMENT=production
SQUARE_APPLICATION_ID=<production Square application ID>
SQUARE_APPLICATION_SECRET=<production Square application secret>
SQUARE_REDIRECT_URI=https://api.flowtally.ca/api/integrations/square/callback
SQUARE_WEBHOOK_SIGNATURE_KEY=<production Square webhook signature key>
INTEGRATION_ENCRYPTION_KEY=<new strong base64 Fernet key>
FLOWTALLY_DEMO_READ_ONLY=false

# Frontend build variables
VITE_ENABLE_PILOT_APP=true
VITE_PILOT_API_BASE_URL=https://api.flowtally.ca
VITE_FLOWTALLY_API_BASE_URL=https://api.flowtally.ca

